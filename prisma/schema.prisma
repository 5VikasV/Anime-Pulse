generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  passwordHash          String
  timezone              String                 @default("Asia/Kolkata")
  region                String                 @default("IN")
  status                String                 @default("ACTIVE")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  notificationEndpoints NotificationEndpoint[]
  follows               Follow[]
}

model NotificationEndpoint {
  id           String                 @id @default(cuid())
  userId       String
  ntfyTopic    String
  status       String                 @default("ACTIVE")
  verifiedAt   DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([userId])
}

model Anime {
  id            String                 @id @default(cuid())
  anilistId     Int                    @unique
  malId         Int?
  title         String
  titleEnglish  String?
  imageUrl      String
  totalEpisodes Int?
  status        String?
  syncedAt      DateTime               @default(now())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  episodes      Episode[]
  follows       Follow[]
  mappings      ProviderAnimeMapping[]
}

model ProviderAnimeMapping {
  id                 String            @id @default(cuid())
  animeId            String
  providerId         String
  providerExternalId String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  anime              Anime             @relation(fields: [animeId], references: [id], onDelete: Cascade)
  provider           StreamingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([animeId, providerId])
}

model Episode {
  id                String                @id @default(cuid())
  animeId           String
  episodeNumber     Int
  scheduledAiringAt DateTime?
  anilistAiringId   Int?
  scheduleSource    String                @default("ANILIST")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  anime             Anime                 @relation(fields: [animeId], references: [id], onDelete: Cascade)
  availabilities    EpisodeAvailability[]
  releaseEvents     ReleaseEvent[]

  @@unique([animeId, episodeNumber])
  @@index([scheduledAiringAt])
}

model Follow {
  id                  String                 @id @default(cuid())
  userId              String
  animeId             String
  enabled             Boolean                @default(true)
  preferredProviderId String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime               Anime                  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  preferredProvider   StreamingProvider?     @relation(fields: [preferredProviderId], references: [id])
  deliveries          NotificationDelivery[]

  @@unique([userId, animeId])
}

model StreamingProvider {
  id               String                 @id @default(cuid())
  identifier       String                 @unique
  name             String
  supportedRegions String                 @default("US,IN,GB")
  enabled          Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  availabilities   EpisodeAvailability[]
  releaseEvents    ReleaseEvent[]
  follows          Follow[]
  mappings         ProviderAnimeMapping[]
}

model EpisodeAvailability {
  id               String            @id @default(cuid())
  episodeId        String
  providerId       String
  region           String
  status           String
  checkedAt        DateTime          @default(now())
  firstConfirmedAt DateTime?
  lastConfirmedAt  DateTime?
  sourceReference  String?
  watchUrl         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  episode          Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  provider         StreamingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([episodeId, providerId, region])
  @@index([status, checkedAt])
}

model ReleaseEvent {
  id         String                 @id @default(cuid())
  episodeId  String
  providerId String
  region     String
  detectedAt DateTime               @default(now())
  episode    Episode                @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  provider   StreamingProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([episodeId, providerId, region])
}

model NotificationDelivery {
  id               String               @id @default(cuid())
  releaseEventId   String
  followId         String
  endpointId       String
  status           String
  idempotencyKey   String               @unique
  attemptCount     Int                  @default(0)
  nextRetryAt      DateTime?
  sentAt           DateTime?
  failedAt         DateTime?
  providerResponse String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  releaseEvent     ReleaseEvent         @relation(fields: [releaseEventId], references: [id], onDelete: Cascade)
  follow           Follow               @relation(fields: [followId], references: [id], onDelete: Cascade)
  endpoint         NotificationEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([releaseEventId])
  @@index([followId])
}

model RateLimit {
  id              String    @id @default(cuid())
  key             String    @unique
  attempts        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
}

